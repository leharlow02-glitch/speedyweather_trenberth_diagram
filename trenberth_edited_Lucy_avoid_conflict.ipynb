    "    datetimes = nsteps > 0 ? Vector{DateTime}(undef, nsteps + 1) : DateTime[]\n",
    "    return TrenberthCallback(0, d, times, datetimes, 0.0, SumFlag, var_longnames, schedule)\n",
    "end\n"
