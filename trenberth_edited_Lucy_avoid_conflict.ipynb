    "using GLMakie, Observables, Dates\n",
    "\n",
    "# ---------------- Assume flux_series, history_obs, time_idx, current_point are already created ----------------\n",
    "# This script expects:\n",
    "# - flux_series: Vector{NamedTuple} with fields LHF, SHF, SSRU, SLRU, SSRD, SLRD, OSR, OLR, albedo, SW_net_sfc, LW_net_sfc, surface_net\n",
    "# - history_obs: Observable(flux_series)\n",
    "# - time_idx: Observable(1)\n",
    "# - current_point: map((hist, idx) -> hist[idx], history_obs, time_idx)\n",
    "\n",
    "nsteps = length(flux_series)\n",
    "\n",
    "# ---------------- Extract individual flux observables ----------------\n",
    "LHF_obs = map(p -> p.LHF, current_point)\n",
    "SHF_obs = map(p -> p.SHF, current_point)\n",
    "SSRU_obs = map(p -> p.SSRU, current_point)\n",
    "SLRU_obs = map(p -> p.SLRU, current_point)\n",
    "SSRD_obs = map(p -> p.SSRD, current_point)\n",
    "SLRD_obs = map(p -> p.SLRD, current_point)\n",
    "OSR_obs = map(p -> p.OSR, current_point)\n",
    "OLR_obs = map(p -> p.OLR, current_point)\n",
    "albedo_obs = map(p -> p.albedo, current_point)\n",
    "SW_net_sfc_obs = map(p -> p.SW_net_sfc, current_point)\n",
    "LW_net_sfc_obs = map(p -> p.LW_net_sfc, current_point)\n",
    "surface_net_obs = map(p -> p.surface_net, current_point)\n",
    "\n",
    "# ---------------- Visual Setup ----------------\n",
    "fig = Figure(size = (1400, 800), backgroundcolor = :white)\n",
    "ax = Axis(fig[1, 1:3], \n",
    "    aspect = DataAspect(),\n",
    "    backgroundcolor = (:lightblue, 0.15))\n",
    "\n",
    "hidedecorations!(ax)\n",
    "hidespines!(ax)\n",
    "xlims!(ax, -3, 3)\n",
    "ylims!(ax, -2, 2.5)\n",
    "\n",
    "# ---------------- Helper function for triangular arrows ----------------\n",
    "function draw_triangle_arrow!(ax, x, y_start, y_end, flux_obs, label, color; scale=400.0, labelside=:left)\n",
    "    # Width based on flux magnitude\n",
    "    width_obs = map(flux_obs) do flux\n",
    "        clamp(abs(flux) / scale * 0.4, 0.08, 0.5)\n",
    "    end\n",
    "    \n",
    "    direction = sign(y_end - y_start)\n",
    "    \n",
    "    # Create triangle vertices\n",
    "    arrow_tri = lift(width_obs) do w\n",
    "        tip_y = y_end\n",
    "        base_y = y_start\n",
    "        [\n",
    "            Point2f(x - w/2, base_y),\n",
    "            Point2f(x + w/2, base_y),\n",
    "            Point2f(x, tip_y)\n",
    "        ]\n",
    "    end\n",
    "    \n",
    "    poly!(ax, arrow_tri, color = color, strokecolor = :black, strokewidth = 1.5)\n",
    "    \n",
    "    # Label placement\n",
    "    label_x = labelside == :left ? x - 0.35 : x + 0.35\n",
    "    label_y = (y_start + y_end) / 2\n",
    "    \n",
    "    label_text = map(flux_obs) do flux\n",
    "        \"$(label)\\n$(round(Int, abs(flux)))\"\n",
    "    end\n",
    "    \n",
    "    text!(ax, label_x, label_y, text = label_text, \n",
    "          fontsize = 10, align = (:center, :center),\n",
    "          color = :black, font = :bold)\n",
    "end\n",
    "\n",
    "# ---------------- Draw boxes ----------------\n",
    "# Atmosphere box\n",
    "atmosphere_box = poly!(ax, \n",
    "    Point2f[(-2.5, 0.2), (2.5, 0.2), (2.5, 1.8), (-2.5, 1.8)],\n",
    "    color = (:skyblue, 0.25), strokecolor = :steelblue, strokewidth = 2)\n",
    "\n",
    "text!(ax, 0, 1.0, text = \"Atmosphere\", fontsize = 18, align = (:center, :center), font = :bold)\n",
    "\n",
    "# Atmosphere net label (observable)\n",
    "atm_net_text = map(current_point) do p\n",
    "    atm_net = p.SSRD - p.OSR - p.OLR + p.SLRU - p.SLRD - p.LHF - p.SHF\n",
    "    \"Atmosphere net =\\n$(round(atm_net, digits=1)) W/m²\"\n",
    "end\n",
    "text!(ax, 2.0, 1.0, text = atm_net_text, fontsize = 11, align = (:left, :center), color = :black)\n",
    "\n",
    "# Surface box  \n",
    "surface_box = poly!(ax, \n",
    "    Point2f[(-2.5, -1.2), (2.5, -1.2), (2.5, 0.0), (-2.5, 0.0)],\n",
    "    color = (:tan, 0.3), strokecolor = :saddlebrown, strokewidth = 2)\n",
    "\n",
    "text!(ax, 0, -0.6, text = \"Surface\", fontsize = 18, align = (:center, :center), font = :bold)\n",
    "\n",
    "# Surface net label (observable)\n",
    "sfc_net_text = map(p -> \"Surface net =\\n$(round(p.surface_net, digits=1)) W/m²\", current_point)\n",
    "text!(ax, -2.0, -0.6, text = sfc_net_text, fontsize = 11, align = (:right, :center), color = :black)\n",
    "\n",
    "# ---------------- Draw flux arrows (from left to right) ----------------\n",
    "# Shortwave down (SSRD) - Yellow\n",
    "draw_triangle_arrow!(ax, -2.0, 2.2, 1.9, SSRD_obs, \"SW Down\", :gold, scale=400, labelside=:left)\n",
    "\n",
    "# Shortwave reflected (SSRU) - Yellow up\n",
    "draw_triangle_arrow!(ax, -1.3, 1.9, 2.2, SSRU_obs, \"Reflected\", :yellow, scale=250, labelside=:left)\n",
    "\n",
    "# Sensible heat (teal/dark cyan)\n",
    "draw_triangle_arrow!(ax, -0.7, -0.1, 1.6, SHF_obs, \"Sensible\", :darkcyan, scale=150, labelside=:right)\n",
    "\n",
    "# Latent heat (blue)\n",
    "draw_triangle_arrow!(ax, 0.0, -0.1, 1.6, LHF_obs, \"Latent\", :dodgerblue, scale=200, labelside=:right)\n",
    "\n",
    "# Longwave down to surface (red/orange down)\n",
    "draw_triangle_arrow!(ax, 0.7, 1.6, -0.1, SLRD_obs, \"LW Down\", :orangered, scale=450, labelside=:left)\n",
    "\n",
    "# Longwave up from surface (red up)\n",
    "draw_triangle_arrow!(ax, 1.4, -0.1, 1.6, SLRU_obs, \"LW Up\", :red, scale=500, labelside=:right)\n",
    "\n",
    "# Shortwave absorbed at surface (yellow down)\n",
    "draw_triangle_arrow!(ax, -2.0, 0.1, -1.0, SW_net_sfc_obs, \"SW Absorbed\", :orange, scale=300, labelside=:left)\n",
    "\n",
    "# Outgoing longwave radiation (dark red up to space)\n",
    "draw_triangle_arrow!(ax, 2.0, 1.9, 2.2, OLR_obs, \"OLR\", :darkred, scale=300, labelside=:right)\n",
    "\n",
    "# Outgoing shortwave (reflected to space)\n",
    "draw_triangle_arrow!(ax, -0.5, 1.9, 2.2, OSR_obs, \"OSR\", :gold, scale=200, labelside=:right)\n",
    "\n",
    "# ---------------- Legend ----------------\n",
    "legend_layout = GridLayout(fig[1, 4], tellwidth = true, tellheight=false, valign=:top)\n",
    "\n",
    "Label(legend_layout[1, 1], \"Legend\", fontsize = 16, font = :bold, halign = :left)\n",
    "\n",
    "# Color boxes for legend\n",
    "poly!(ax, Point2f[(2.3, -1.8), (2.4, -1.8), (2.4, -1.7), (2.3, -1.7)], color = :gold)\n",
    "text!(ax, 2.45, -1.75, text = \"Shortwave\", fontsize = 10, align = (:left, :center))\n",
    "\n",
    "poly!(ax, Point2f[(2.3, -1.95), (2.4, -1.95), (2.4, -1.85), (2.3, -1.85)], color = :red)\n",
    "text!(ax, 2.45, -1.9, text = \"Longwave\", fontsize = 10, align = (:left, :center))\n",
    "\n",
    "poly!(ax, Point2f[(2.3, -2.1), (2.4, -2.1), (2.4, -2.0), (2.3, -2.0)], color = :darkcyan)\n",
    "text!(ax, 2.45, -2.05, text = \"Sensible (teal)\", fontsize = 10, align = (:left, :center))\n",
    "\n",
    "poly!(ax, Point2f[(2.3, -2.25), (2.4, -2.25), (2.4, -2.15), (2.3, -2.15)], color = :dodgerblue)\n",
    "text!(ax, 2.45, -2.2, text = \"Latent (blue)\", fontsize = 10, align = (:left, :center))\n",
    "\n",
    "# ---------------- Info Panel ----------------\n",
    "info_layout = GridLayout(fig[2, 1:3], tellheight=true)\n",
    "\n",
    "# Time and step info (observable)\n",
    "time_text = map(current_point) do p\n",
    "    \"$(p.datetime)  |  Step: $(time_idx[])/$(nsteps)\"\n",
    "end\n",
    "time_label = Label(info_layout[1, 1], time_text, fontsize = 12, halign = :left, color = :gray)\n",
    "\n",
    "# Additional values (observable)\n",
    "vals_text = map(p -> \"Albedo: $(round(p.albedo, digits=3))  |  LW net sfc: $(round(Int, p.LW_net_sfc)) W/m²\", current_point)\n",
    "vals_label = Label(info_layout[1, 2], vals_text, fontsize = 11, halign = :center)\n",
    "\n",
    "# ---------------- Controls ----------------\n",
    "control_layout = GridLayout(fig[2, 4], tellheight=true)\n",
    "\n",
    "slider = Slider(control_layout[1, 1], range = 1:nsteps, startvalue = 1)\n",
    "play_button = Button(control_layout[2, 1], label = \"▶ Play\")\n",
    "reset_button = Button(control_layout[3, 1], label = \"⟲ Reset\")\n",
    "\n",
    "is_playing = Observable(false)\n",
    "running_task = Ref{Union{Task, Nothing}}(nothing)\n",
    "\n",
    "on(slider.value) do v\n",
    "    time_idx[] = Int(round(v))\n",
    "end\n",
    "\n",
    "on(time_idx) do i\n",
    "    set_close_to!(slider, i)\n",
    "end\n",
    "\n",
    "on(play_button.clicks) do _\n",
    "    is_playing[] = !is_playing[]\n",
    "    \n",
    "    if is_playing[]\n",
    "        play_button.label = \"⏸ Pause\"\n",
    "        \n",
    "        # Stop old task if exists\n",
    "        if running_task[] !== nothing && !istaskdone(running_task[])\n",
    "            try\n",
    "                @async Base.throwto(running_task[], InterruptException())\n",
    "            catch\n",
    "            end\n",
    "        end\n",
    "        \n",
    "        # Start new task\n",
    "        running_task[] = @async begin\n",
    "            try\n",
    "                while is_playing[]\n",
    "                    nexti = time_idx[] + 1\n",
    "                    if nexti > nsteps\n",
    "                        nexti = 1  # Loop\n",
    "                    end\n",
    "                    time_idx[] = nexti\n",
    "                    sleep(0.05)\n",
    "                    yield()  # Allow task switching\n",
    "                end\n",
    "            catch e\n",
    "                if !(e isa InterruptException)\n",
    "                    @warn \"Animation task error\" exception=e\n",
    "                end\n",
    "            end\n",
    "        end\n",
    "    else\n",
    "        play_button.label = \"▶ Play\"\n",
    "        # Stop the task\n",
    "        if running_task[] !== nothing && !istaskdone(running_task[])\n",
    "            try\n",
    "                @async Base.throwto(running_task[], InterruptException())\n",
    "            catch\n",
    "            end\n",
    "        end\n",
    "    end\n",
    "end\n",
    "\n",
    "on(reset_button.clicks) do _\n",
    "    is_playing[] = false\n",
    "    play_button.label = \"▶ Play\"\n",
    "    time_idx[] = 1\n",
    "    \n",
    "    # Stop task\n",
    "    if running_task[] !== nothing && !istaskdone(running_task[])\n",
    "        try\n",
    "            @async Base.throwto(running_task[], InterruptException())\n",
    "        catch\n",
    "        end\n",
    "    end\n",
    "end\n",
    "\n",
    "display(fig)\n",
    "\n",
    "# Cleanup function - call this before closing\n",
    "function cleanup_animation()\n",
    "    is_playing[] = false\n",
    "    if running_task[] !== nothing && !istaskdone(running_task[])\n",
    "        try\n",
    "            @async Base.throwto(running_task[], InterruptException())\n",
    "        catch\n",
    "        end\n",
    "    end\n",
    "end"
   ]
